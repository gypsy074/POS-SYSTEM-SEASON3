flowchart TB
    cashier["Cashier builds order"] --> submit["POST /api/orders"]
    submit --> validation["Normalize order and validate payment"]
    validation --> senior{"Senior discount?"}
    senior -- "Yes" --> seniorCheck{"ID and customer name valid?"}
    seniorCheck -- "No" --> rejectDiscount["Reject order"]
    seniorCheck -- "Yes" --> idempotency
    senior -- "No" --> idempotency
    idempotency{"clientOrderId already saved?"}
    idempotency -- "Yes" --> existing["Return existing order"]
    idempotency -- "No" --> stock{"Menu or linked supply stock available?"}
    stock -- "No" --> shortage["409 shortage<br/>Do not save order"]
    stock -- "Yes" --> save["Save order"]
    save --> deduct["Deduct menu and linked supply stock"]
    deduct --> availability["Recompute linked menu availability"]
    availability --> alert{"Below low-stock threshold?"}
    alert -- "Yes" --> email["Try deduplicated owner alert"]
    alert -- "No" --> complete["Return saved order"]
    email --> complete

    complete --> status["Completed order remains in history"]
    status --> action{"Void or refund requested?"}
    action -- "No" --> reports["Included in completed sales"]
    action -- "Yes" --> override{"Role, ownership, and any override valid?"}
    override -- "No" --> rejectAction["Reject action"]
    override -- "Yes" --> state{"Current status allows action?"}
    state -- "No" --> rejectAction
    state -- "Yes" --> restore["Restore menu and linked supply stock"]
    restore --> mark["Mark Voided or Refunded"]
    mark --> audit["Write order action audit event"]
    mark --> excluded["Exclude from completed sales"]

    restock["Manual linked inventory edit or restock"] --> availability
