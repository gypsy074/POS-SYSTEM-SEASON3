erDiagram
    USERS ||--o{ SESSIONS : "owns"
    PRODUCTS }o--o{ INVENTORYITEMS : "linked by menuProductIds"

    USERS {
        ObjectId _id PK
        string username UK
        string password
        string role
        string status
        date lastActiveAt
    }

    SESSIONS {
        ObjectId _id PK
        ObjectId userId FK
        string jti UK
        string ip
        string userAgent
        date createdAt
        date expiresAt
        boolean revoked
    }

    PRODUCTS {
        ObjectId _id PK
        string name
        string category
        number price
        number stock
        number lowStockThreshold
        string status
        string image
    }

    INVENTORYITEMS {
        ObjectId _id PK
        string productName
        string category
        number stock
        number unitsPerSale
        number lowStockThreshold
        ObjectId menuProductIds FK
    }

    ORDERS {
        ObjectId _id PK
        string customer
        string cashier
        string receiptId
        string status
        string paymentMethod
        array items
        number subtotal
        number discountAmount
        number total
        string clientOrderId UK
        date date
    }

    WASTEITEMS {
        ObjectId _id PK
        string productName
        string cashier
        number quantity
        number totalCost
        string reason
        date date
    }

    CATEGORIES {
        ObjectId _id PK
        string name
    }

    AUDITLOGS {
        ObjectId _id PK
        string action
        string actor
        string targetId
        string detail
        date date
    }

    OWNERALERTSETTINGS {
        string _id PK
        number dailySalesTarget
        array recipients
        boolean lowStockEnabled
        boolean dailySummaryEnabled
        number dailySummaryHour
        string lastDailySentDate
        map lowStockLastSent
    }
