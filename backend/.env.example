# Required environment variables for the Season 3 POS backend.
# Copy this file to `.env` for local development, and set the same keys
# in the Render dashboard (Dashboard → your service → Environment).

# MongoDB Atlas connection string.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pos?retryWrites=true&w=majority
# NOTE: rotate your Atlas password if the old one ever appeared in git history.
MONGO_URI=

# Secret used to sign JWT sessions. Use a long random string.
# Linux/Mac: openssl rand -hex 32     Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed origins. "*" allows everything (classroom use).
# Example: https://season3-pos.onrender.com,http://192.168.1.50:3000
CORS_ORIGIN=

# Optional: session lifetime, default 8h.
# JWT_EXPIRES_IN=8h

# Optional: default admin credentials on first boot (username/password).
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=admin123

# Optional: Google AI Studio free-tier API key for the AI business report
# (gemini-2.0-flash). Create one at https://aistudio.google.com/apikey .
# When missing, the report falls back to a statistics summary instead.
# AI_API_KEY=

# Optional: AI provider for the business report. "gemini" (default) or
# "groq" (free tier, llama-3.3-70b-versatile; key from https://console.groq.com ).
# AI_PROVIDER=gemini
# GROQ_API_KEY=
# AI_MODEL=

# Owner email alerts (nodemailer via SMTP). Gmail: enable 2FA on the
# sending account, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
# When these are missing, alert emails are skipped (the admin Settings
# panel shows "SMTP not configured").
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=you@gmail.com